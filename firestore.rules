rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }
    
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Batches collection - PUBLIC READ for marketplace, restricted writes
    match /batches/{batchId} {
      allow read: if true;  // Public read access for marketplace/home page
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.farmerId == request.auth.uid ||
        hasRole('inspector') ||
        hasRole('government')
      );
      allow delete: if isAuthenticated() && resource.data.farmerId == request.auth.uid;
    }
    
    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
    }
    
    // Storage records
    match /storageRecords/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Processing records
    match /processingRecords/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Course enrollments
    match /courseEnrollments/{enrollmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Processing requests
    match /processingRequests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Tracking entries
    match /trackingEntries/{entryId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Wool quality collection
    match /wool_quality/{docId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
    }
  }
}